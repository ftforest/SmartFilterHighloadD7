/bitrix/
/upload/

# start
# Bitrix ядро
/bitrix/*
!/bitrix/php_interface/
!/bitrix/php_interface/init.php
!/bitrix/php_interface/events.php
!/bitrix/modules/*
!/bitrix/modules/*/
!/bitrix/modules/main/
!/bitrix/modules/main/*
!/bitrix/modules/main/classes/
!/bitrix/modules/main/classes/general/
/bitrix/managed_cache/
/bitrix/cache/
/bitrix/stack_cache/
/bitrix/backup/
/bitrix/updates/
/bitrix/tmp/

# Загруженные файлы
/upload/*
!/upload/.gitkeep

# Локальные настройки
/bitrix/.settings.php
/bitrix/php_interface/dbconn.php
/local/php_interface/dbconn.php

# Логи
*.log

# IDE
.idea/
.vscode/
*.swp

# Composer
/vendor/